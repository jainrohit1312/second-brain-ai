# Dependencies
node_modules/
.pnpm-store/
.yarn/
.pnp.*
bower_components/

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
.swc/

# Generated by Next.js on every build; never hand-edited, never committed
next-env.d.ts

# Bundle analysis
analyze/
*.bundle.js

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# Chrome extension build output
apps/chrome-extension/dist/
apps/chrome-extension/*.zip
apps/chrome-extension/.vite/

# Android / Gradle
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/.idea/
apps/android/captures/
*.apk
*.aab
*.keystore
!debug.keystore

# Supabase local stack
supabase/.branches/
supabase/.temp/
supabase/.env

# Testing
coverage/
.nyc_output/
*.lcov

# Agent scratch space (Qwen Code). Verification scripts, temp copies and extracted
# fragments live here and are never part of the tree. `.qwen/` itself stays
# committable, because it is also where shared workflows, skills and settings go.
.qwen/tmp/

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
