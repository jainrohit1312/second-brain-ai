{
  "name": "@second-brain/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manifest V3 extension that captures page reads, selections, and video watches into the Second Brain.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo",
    "zip": "cd dist && bestzip ../second-brain-extension.zip *"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@second-brain/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "bestzip": "^2.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
