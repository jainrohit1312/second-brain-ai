# ---------------------------------------------------------------------------
# Second Brain — environment template
#
# Copy to `.env` at the repo root for local development:
#     cp .env.example .env
# Never commit a populated .env. See docs/ARCHITECTURE.md for how each value
# is consumed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Supabase --------------------------------------------------------------
# Postgres + pgvector + Auth + Storage. The local stack port is shifted to 55321
# (see supabase/config.toml) so it can run alongside other local Supabase projects
# on this machine. ALL THREE URL variables below must carry the same port: a
# mismatch does not fail, it silently points a client at a different project's
# local database.
SUPABASE_URL=http://127.0.0.1:55321
# Safe for browsers and the extension bundle. Row Level Security is the guard.
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. NEVER expose to apps/web, the extension, or Android.
SUPABASE_SERVICE_ROLE_KEY=
# JWT signing secret used by the local Supabase stack.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Embedding providers ---------------------------------------------------
# OpenAI text-embedding-3-small  -> 1536 dims
# Gemini text-embedding-004      -> 768 dims
# NVIDIA nv-embedqa-e5-v5        -> 1024 dims  (the pinned default)
#
# The model id is fully qualified, matching what the NVIDIA API expects.
# EMBEDDING_MODEL and EMBEDDING_DIMENSIONS are a PINNED PAIR: the dimension is a
# correctness constraint against every `vector(1024)` column, not a tuning knob.
# Changing the model means a migration plus a full re-embed; see ADR-004 and
# ADR-021 in docs/DECISIONS.md.
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=

# --- LLM providers ---------------------------------------------------------
# Used for classification, distillation, and chat synthesis.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional local inference (Ollama / LM Studio / vLLM)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=

# --- Ingestion -------------------------------------------------------------
# Shared secret the clients present on /ingest. Rotate per device in prod.
INGEST_SHARED_SECRET=
# Events below this score are dropped before they reach the queue.
IMPORTANCE_MIN_THRESHOLD=0.25
# Max events per batch sync request.
SYNC_BATCH_SIZE=100
# Seconds of inactivity before the extension flushes its queue.
IDLE_FLUSH_DELAY_SECONDS=60

# --- Processing / retrieval tuning ----------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=40
RERANK_TOP_K=8
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_FTS_WEIGHT=0.4
# Only needed when RERANK_PROVIDER=cohere. Reranking is optional: with no key
# the pipeline degrades to NoopReranker rather than failing the request.
RERANK_PROVIDER=noop
COHERE_API_KEY=

# --- Web app ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# --- Chrome extension ------------------------------------------------------
# Injected at build time by Vite (import.meta.env). Must be public values only.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
# The retrieval/chat API base — NOT the ingestion one. Activity batches are posted to
# the `process-activity` edge function at `{VITE_SUPABASE_URL}/functions/v1/...`
# through supabase-js, so no capture path depends on a local HTTP server (ADR-022).
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_SYNC_INTERVAL_SECONDS=120
# Phase 1a only — device registration Edge Function ships in a later phase.
# This UUID must exist in second_brain.devices for the signed-in user.
# Phase 1a dev value: 11111111-1111-4111-8111-111111111111
VITE_DEVICE_ID=

# --- Android ---------------------------------------------------------------
# Consumed via gradle.properties / BuildConfig, not this file. Listed here so
# the full surface of configuration is visible in one place. See apps/android.
